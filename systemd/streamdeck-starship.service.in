[Unit]
Description=Elgato Stream Deck Starship controller
Documentation=file://@PROJECT_ROOT@/README.md
After=graphical-session-pre.target
PartOf=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=@PROJECT_ROOT@/target/release/streamdeck-starship
WorkingDirectory=@PROJECT_ROOT@
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
